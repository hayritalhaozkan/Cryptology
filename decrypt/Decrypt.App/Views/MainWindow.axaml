<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Decrypt.App.Views.MainWindow"
        Width="640" Height="780"
        Title="🔓 Decrypt - Şifre Çözme Uygulaması"
        CanResize="True"
        MinWidth="560" MinHeight="700">

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#D83B01"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="6">

      <!-- Başlık -->
      <TextBlock Classes="header" Text="🔓 Şifre Çözme"/>
      <Separator Margin="0,0,0,4"/>

      <!-- Yöntem Seçimi -->
      <TextBlock Classes="label" Text="Çözme Yöntemi:"/>
      <ComboBox x:Name="MethodCombo" HorizontalAlignment="Stretch"/>

      <!-- Yöntem İpucu -->
      <TextBlock x:Name="HintText" FontSize="11" Foreground="Gray"
                 TextWrapping="Wrap" Margin="0,0,0,2"/>

      <!-- Şifreli Metin Girişi -->
      <TextBlock Classes="label" Text="Şifreli Metin:"/>
      <TextBox x:Name="CipherTextBox"
               AcceptsReturn="True"
               Height="100"
               TextWrapping="Wrap"
               Watermark="Şifreli metni girin veya yapıştırın..."/>

      <!-- Dinamik Anahtar Alanları -->
      <TextBlock Classes="label" Text="Anahtar Bilgileri:"/>
      <StackPanel x:Name="KeyFieldsPanel" Spacing="4"/>

      <!-- Butonlar -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button x:Name="DecryptBtn" Content="🔓 Çöz" Classes="primary"/>
        <Button x:Name="CopyBtn" Content="📋 Kopyala" Classes="secondary"/>
        <Button x:Name="ClearBtn" Content="🗑 Temizle" Classes="secondary"/>
      </StackPanel>

      <!-- Çözülmüş Metin -->
      <TextBlock Classes="label" Text="Çözülmüş Metin:"/>
      <TextBox x:Name="PlainTextBox"
               AcceptsReturn="True"
               Height="100"
               IsReadOnly="True"
               TextWrapping="Wrap"
               Watermark="Sonuç burada görünecek..."/>

      <!-- Durum -->
      <TextBlock x:Name="StatusText" FontSize="12" Foreground="#D83B01"
                 TextWrapping="Wrap" Margin="0,2,0,0"/>




    </StackPanel>
  </ScrollViewer>
</Window>